# Troque pelo domínio apontado para o IP do servidor.
# Sem este arquivo, o pacote abre apenas em HTTP na porta 80.
SITE_ADDRESS=erp.seudominio.com.br

# OBRIGATÓRIO: connection string do PostgreSQL em nuvem (Supabase, Neon,
# Railway, AWS RDS ou outro serviço compatível). Todos os dados do sistema
# (usuários, empresas, permissões, clientes, auditoria etc.) ficam neste
# banco — nada é armazenado localmente no servidor além da chave de
# criptografia abaixo. Use sempre sslmode=require em produção.
# Exemplo Supabase: postgresql://postgres:SENHA@db.xxxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Máximo de conexões simultâneas no pool do backend (ajuste conforme o
# limite de conexões do seu plano no provedor de PostgreSQL).
DATABASE_POOL_MAX=10

# Chave mestra de criptografia (Fernet) usada para cifrar certificados
# digitais e documentos fiscais sensíveis no banco. Se não definida aqui, o
# servidor gera e persiste uma em app/data/.gestao-fiscal.key — o que só é
# seguro se o volume de disco for persistente entre deploys. Em plataformas
# com disco efêmero (a maioria dos serviços de container em nuvem), gere uma
# chave uma única vez com:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# e cole o valor aqui. Nunca a compartilhe nem a commite no repositório —
# sem ela, os dados cifrados no banco ficam permanentemente ilegíveis.
GESTAOFISCAL_MASTER_KEY=

# Integração oficial opcional de consulta CNPJ (SERPRO).
SERPRO_CNPJ_CONSUMER_KEY=
SERPRO_CNPJ_CONSUMER_SECRET=

# Usado apenas se você iniciar com um banco totalmente vazio.
CONTTECH_ADMIN_EMAIL=
CONTTECH_ADMIN_NAME=Administrador
CONTTECH_ADMIN_PASSWORD=
